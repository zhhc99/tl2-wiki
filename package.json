{
  "name": "tl2-wiki",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,json}\" vite.config.ts package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,json}\" vite.config.ts package.json",
    "data:import": "node scripts/import-tl2-db.mjs",
    "data:refresh": "bash scripts/refresh-tl2-data.sh",
    "data:validate": "node scripts/validate-data.mjs",
    "text:extract": "node scripts/extract-non-database-text.mjs",
    "check": "npm run format:check && npm run data:validate && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2",
    "prettier": "3.6.2"
  }
}
