{
  "name": "tl2-wiki",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b && react-router build && node scripts/prepare-pages.mjs && node scripts/check-build-output.mjs",
    "preview": "vite preview --base / --outDir build/client",
    "typecheck": "react-router typegen && tsc -b --pretty false",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,json}\" vite.config.ts react-router.config.ts package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,json}\" vite.config.ts react-router.config.ts package.json",
    "data:import": "node scripts/import-tl2-db.mjs && node scripts/generate-derived-data.mjs",
    "data:derive": "node scripts/generate-derived-data.mjs",
    "data:refresh": "bash scripts/refresh-tl2-data.sh",
    "data:validate": "node scripts/validate-data.mjs",
    "check": "npm run format:check && npm run data:validate && npm run build"
  },
  "dependencies": {
    "@react-router/node": "^7.18.3",
    "isbot": "^5.2.2",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.18.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.3",
    "@types/node": "^26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  }
}
